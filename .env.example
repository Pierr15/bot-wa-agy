# Konfigurasi Umum
LOG_LEVEL=info
TZ=Asia/Jakarta
BOT_NAME=WaBot

# Mode Login WhatsApp: qr | pairing
# Gunakan "pairing" jika WhatsApp dan bot berjalan di HP yang sama.
# Gunakan "qr" jika WhatsApp di-scan dari perangkat lain.
LOGIN_MODE=qr
BOT_PHONE_NUMBER=

# Whitelist Nomor (pisahkan dengan koma, format: 08xx / 628xx)
OWNER_NUMBERS=
ALLOWED_NUMBERS=
ALLOWED_GROUPS=

# Pengaturan Stiker
STICKER_DEFAULT_POSITION=bottom
STICKER_MAX_CHARS=140
STICKER_FONT_PATH=assets/fonts/Anton-Regular.ttf
STICKER_ANIM_MAX_SEC=6
STICKER_ANIM_MAX_KB=300
MAX_IMAGE_MB=10

# Pengaturan Downloader
DOWNLOAD_MAX_MB=16
DOWNLOAD_SOURCE_MAX_MB=100
DOWNLOAD_MAX_DURATION_SEC=300
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_TIMEOUT_SEC=90
MIN_FREE_DISK_MB=1024
MAX_QUEUE=20
ENABLE_TIKWM_FALLBACK=true

# Lokasi File & Path Binary
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
IG_COOKIES_PATH=data/cookies/instagram.txt
DATA_DIR=data
TMP_DIR=data/tmp
AUTH_DB=data/auth/whatsapp.db
